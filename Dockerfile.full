# Full-app image: api/app.py's create_app() with every view and route
# (Conversation, Review, Listening, Speaking, Progress, replay, recap).
# Sibling of Dockerfile, which stays the Review-only public build Render deploys.
#
# Live voice cannot work in a container: Conversation's Start spawns a pipecat
# bot that opens the host microphone through pyaudio, and a container has no
# mic. Every other feature runs. Browser-based voice would need the WebRTC
# transport (see spike/), which is a separate project.
#
#   docker build -f Dockerfile.full -t spanish-companion-full .
#   docker run -d --name sc-full -p 10000:10000 --env-file .env.docker spanish-companion-full

# --- Stage 1: frontend (full build, all tabs) ---
FROM node:25-alpine AS frontend-build
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# --- Stage 2: Python runtime (same layers as Dockerfile; see its comments) ---
FROM python:3.12-slim AS runtime
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends -o Acquire::Retries=5 \
        gcc libc6-dev portaudio19-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

ENV HF_HUB_DISABLE_XET=1
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2')"
ENV HF_HUB_OFFLINE=1

COPY api/ api/
COPY rag/ rag/
COPY common/ common/
COPY alembic/ alembic/
COPY alembic.ini .
COPY --from=frontend-build /app/frontend/dist frontend/dist

# The full app writes flags, transcripts, session logs and audio under data/.
RUN mkdir -p data

ENV PYTHONUNBUFFERED=1
ENV PORT=10000
EXPOSE 10000
ENV ALLOWED_ORIGINS=http://localhost:10000,http://127.0.0.1:10000

# ponytail: gthread, not sync -- /api/events is a long-lived SSE stream and
# would block the only sync worker. One worker because the embedding model is
# ~470MB per process; raise threads, not workers.
CMD gunicorn "api.app:create_app()" --bind 0.0.0.0:$PORT --workers 1 --worker-class gthread --threads 8 --timeout 120
