AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
GEMINI_API_KEY=
DATABASE_URL=postgresql+pg8000://user:password@localhost:5432/spanish_companion

# Scratch Postgres DB for Integration/Acceptance tests (tests/integration,
# tests/acceptance) -- never dev data. Create with `CREATE DATABASE
# spanish_companion_test;`, then `alembic upgrade head` with this URL set as
# DATABASE_URL to apply the schema, per CLAUDE.md's Phase 2 test strategy.
TEST_DATABASE_URL=postgresql+pg8000://user:password@localhost:5432/spanish_companion_test

# Optional — override the voice-loop defaults (Step 1)
GEMINI_MODEL=gemini-flash-lite-latest
AZURE_TTS_VOICE=es-ES-XimenaMultilingualNeural
# Match your output device's native sample rate (check with PyAudio's
# get_default_output_device_info) if TTS playback sounds sped up/cut short.
AUDIO_OUT_SAMPLE_RATE=24000
# Silero VAD's silence-before-"stopped speaking" window, in seconds. Stock
# default is 0.2s; raise it if background noise keeps the bot from
# responding (each noise blip resets the window before it closes), lower
# it if the bot starts responding before you're actually done talking.
VAD_STOP_SECS=0.5

# Silero VAD's speech-probability threshold (0.0-1.0). Stock default is 0.7;
# raise it (e.g. 0.85) if steady background noise (fan, hum, room noise)
# false-triggers "user speaking," lower it if quiet speech onset gets missed.
VAD_CONFIDENCE=0.7

# Optional — override ConversationSessionService's stop-escalation timeouts
# and ready-warmup heuristic (Phase 2, api/services/session_lifecycle.py)
SESSION_GRACEFUL_TIMEOUT_SECONDS=5
SESSION_TERMINATE_TIMEOUT_SECONDS=2
SESSION_READY_WARMUP_SECONDS=16

# Optional — override where FlagBroker/PracticeLogBroker read and write
# their JSON files (Phase 2, api/brokers/flag.py, api/brokers/practice_log.py)
FLAGS_FILE_PATH=data/flags.json
PRACTICE_LOG_FILE_PATH=data/practice_log.jsonl

# Optional — stop-flag file BotProcessBroker touches to request graceful
# shutdown, polled by ConversationOrchestrator (api/services/voice_conversation.py).
# Replaces Windows CTRL_BREAK_EVENT, which Python 3 doesn't reliably deliver
# across process boundaries — confirmed broken via isolated repro, 2026-08-29.
STOP_SIGNAL_FILE_PATH=data/stop_signal

# Optional — where TurnStateService writes the pipeline's current turn
# state (listening/thinking/speaking/idle), polled by /api/events for the
# frontend's turn indicator (api/brokers/session_log/session_log_broker.py)
TURN_STATE_FILE_PATH=data/turn_state.txt

# Optional — how many corpus chunks Review Mode retrieves before grounding an
# explanation on the top-ranked one (Phase 2, api/services/review.py)
RETRIEVAL_TOP_K=3

# Optional — max pgvector cosine distance a chunk may have and still ground
# an explanation (MaxDistanceFilter, rag/services/orchestrations/retrieval/
# strategies/filters.py). Past this, retrieve() returns [] and Review falls
# back to "no corpus match" instead of citing an unrelated RAE topic — fixes
# the RAG explanation quality gap (diagnosed 2026-09-10: no floor existed, so
# an off-corpus query like "gender agreement" always got the least-bad of the
# 3 covered topics). 0.65 is a starting guess, not measured against this
# corpus's real distance distribution — tighten/loosen from real flag logs.
RETRIEVAL_MAX_DISTANCE=0.65

# Optional — pressure-dial pace level for a hand-started bot with no Flask
# session (gentle/normal/push). Flask's /start injects this per-session
# instead when the frontend dial is used; unset/unknown falls back to
# "normal" either way (D5, api/services/orchestrations/voice_conversation/
# _pressure.py).
SESSION_PRESSURE=normal

# Optional — comma-separated origins allowed past app.py's Origin/Referer
# check (api/app.py). Include both "localhost" and "127.0.0.1" forms for
# whichever host:port you actually browse to — a form missing here 403s.
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173,http://localhost:10000,http://127.0.0.1:5000,http://127.0.0.1:5173,http://127.0.0.1:10000
