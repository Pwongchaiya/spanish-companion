AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
GEMINI_API_KEY=
DATABASE_URL=postgresql+pg8000://user:password@localhost:5432/spanish_companion

# Scratch Postgres DB for Integration/Acceptance tests (tests/integration,
# tests/acceptance) -- never dev data. Create with `CREATE DATABASE
# spanish_companion_test;`, then `alembic upgrade head` with this URL set as
# DATABASE_URL to apply the schema, per CLAUDE.md's Phase 2 test strategy.
TEST_DATABASE_URL=postgresql+pg8000://user:password@localhost:5432/spanish_companion_test

# Optional — override the voice-loop defaults (Step 1)
GEMINI_MODEL=gemini-flash-lite-latest
# Also the voice for /tts/synthesize and the spoken session recap (Review Mode)
AZURE_TTS_VOICE=es-ES-XimenaMultilingualNeural
# Match your output device's native sample rate (check with PyAudio's
# get_default_output_device_info) if TTS playback sounds sped up/cut short.
AUDIO_OUT_SAMPLE_RATE=24000
# Silero VAD's silence-before-"stopped speaking" window, in seconds. Stock
# default is 0.2s; raise it if background noise keeps the bot from
# responding (each noise blip resets the window before it closes), lower
# it if the bot starts responding before you're actually done talking.
VAD_STOP_SECS=0.5

# Silero VAD's speech-probability threshold (0.0-1.0). Stock default is 0.7;
# raise it (e.g. 0.85) if steady background noise (fan, hum, room noise)
# false-triggers "user speaking," lower it if quiet speech onset gets missed.
VAD_CONFIDENCE=0.7

# Optional — override ConversationSessionService's stop-escalation timeouts
# and ready-warmup heuristic (Phase 2, api/services/session_lifecycle.py)
SESSION_GRACEFUL_TIMEOUT_SECONDS=5
SESSION_TERMINATE_TIMEOUT_SECONDS=2
SESSION_READY_WARMUP_SECONDS=16

# Optional — override where FlagBroker/PracticeLogBroker read and write
# their JSON files (Phase 2, api/brokers/flag.py, api/brokers/practice_log.py)
FLAGS_FILE_PATH=data/flags.json
PRACTICE_LOG_FILE_PATH=data/practice_log.jsonl

# Optional — stop-flag file BotProcessBroker touches to request graceful
# shutdown, polled by ConversationOrchestrator (api/services/voice_conversation.py).
# Replaces Windows CTRL_BREAK_EVENT, which Python 3 doesn't reliably deliver
# across process boundaries — confirmed broken via isolated repro, 2026-08-29.
STOP_SIGNAL_FILE_PATH=data/stop_signal

# Optional — where TurnStateService writes the pipeline's current turn
# state (listening/thinking/speaking/idle), polled by /api/events for the
# frontend's turn indicator (api/brokers/session_log/session_log_broker.py)
TURN_STATE_FILE_PATH=data/turn_state.txt

# Optional — how many corpus chunks Review Mode retrieves per flag (Phase 2,
# api/services/review.py), passed on to GenerationService.explain() as its
# candidate chunk list (see EXPLAIN_TOP_K below)
RETRIEVAL_TOP_K=3

# Optional — of the retrieved chunks Review passes to explain(), how many
# GenerationService actually grounds the explanation on (#64: was chunks[0]
# only, often the wrong section of the right topic). Read once at
# GenerationService construction (rag/services/foundations/generation/).
# Independent knob from RETRIEVAL_TOP_K -- raise this without changing how
# many chunks retrieval fetches, or vice versa.
EXPLAIN_TOP_K=3

# Optional — sampling temperature for GenerationService's shared/draft broker
# (rag/brokers/generation/generation_broker.py), used by explain()'s draft call and
# every other GenerationService method that calls self._broker directly
# (judge_practice_attempt(), estimate_cefr_level(), generate_text(),
# judge_task_outcome()) -- all judgment/explanation calls, not creative generation,
# so one low-temperature knob is safe for all of them. Added 2026-10-02 (#86):
# at the API's default (nonzero) temperature, explain()'s draft varied enough
# run to run that the (already temperature-0, #68) grounding judge rejected a
# different 4-17 of 24 eval questions each run. Default 0 for determinism.
GENERATION_TEMPERATURE=0

# Optional — sampling temperature for GenerationService's reflective grounding
# judge only (_is_grounded, rag/services/foundations/generation/generation_service.py)
# -- the second call that decides whether explain()'s draft is actually supported by
# the retrieved chunks. Unset (default) keeps today's behavior for any caller not
# wiring a dedicated judge_broker. Added 2026-09-26 (#68): at the draft's own default
# (nonzero) temperature, this judge randomly rejected good drafts, showing up as
# "fallback despite expected topic" in evals/run_eval.py. The draft call itself was
# unaffected by this knob alone -- see GENERATION_TEMPERATURE above (#86), added later
# to pin it too.
GROUNDING_JUDGE_TEMPERATURE=0

# Optional — total Gemini attempts (incl. the first) for Review's draft and
# grounding-judge brokers and evals/run_eval.py, on transient 408/429/5xx errors
# (google-genai's own backoff: ~1, 2, 4, 8s). Added 2026-10-02 (#92): un-retried
# 503 "high demand" errors were 7-13 of 21 Review fallbacks. Voice Conversation's
# broker deliberately doesn't retry (its teardown must fit the 5s graceful stop).
GENERATION_RETRY_ATTEMPTS=5

# Optional — max pgvector cosine distance a chunk may have and still ground
# an explanation (MaxDistanceFilter, rag/services/orchestrations/retrieval/
# strategies/filters.py). Past this, retrieve() returns [] and Review falls
# back to "no corpus match" instead of citing an unrelated RAE topic — fixes
# the RAG explanation quality gap (diagnosed 2026-09-10: no floor existed, so
# an off-corpus query like "gender agreement" always got the least-bad of the
# 3 covered topics). Tightened 2026-09-26 (#67): a phrasebook-vocab question
# ("La cuenta, por favor.") false-positived at 0.65 -- articles 0.5948,
# object-pronouns 0.6002 both cleared it. 0.59 drops both with zero regression
# on any real-topic eval question (evals/questions.yaml, --retrieval-only).
RETRIEVAL_MAX_DISTANCE=0.59

# Optional — sampling temperature for the eval's own answer-quality LLM judge
# only (evals/run_eval.py's build_pipeline(), GeminiGenerationBroker's `temperature`
# param -- rag/brokers/generation/generation_broker.py; separate from
# GROUNDING_JUDGE_TEMPERATURE above, which pins the production grounding judge
# instead). The draft call is pinned separately via GENERATION_TEMPERATURE (#86)
# so its residual noise stays measured, not hidden. Added 2026-09-26 (#68) after
# the un-pinned judge's own run-to-run non-determinism (Gemini default temperature)
# turned out to be as large as the retrieval/generation regression being
# investigated -- 8/24
# questions flipped pass/fail between two identical-config eval runs.
EVAL_JUDGE_TEMPERATURE=0

# Optional — how much answer_pass_rate may drop vs. --baseline before
# evals/run_eval.py exits 1 (regressions(), evals/run_eval.py). Was 0.0 (any
# drop fails); #86 showed answer_pass_rate still has real run-to-run spread
# even with GENERATION_TEMPERATURE/GROUNDING_JUDGE_TEMPERATURE/
# EVAL_JUDGE_TEMPERATURE all pinned to 0 (remaining noise is the grounding
# judge's prompt strictness, a separate, open question -- not fixed by pinning
# temperature). Measured 2026-10-02, 5 runs same config: answer_pass_rate
# 0.2917, 0.2917, 0.3333, 0.4167, 0.3333 -- spread (max-min) 0.125, rounded up
# to the next 0.05.
EVAL_REGRESSION_TOLERANCE=0.15

# Optional — candidates fetched per retrieval before filtering (default 50).
# Chunks matching the flag's category skip RETRIEVAL_MAX_DISTANCE, so the pool
# must be deep enough to reach them.
RETRIEVAL_CANDIDATE_POOL=50

# Optional — pressure-dial pace level for a hand-started bot with no Flask
# session (gentle/normal/push). Flask's /start injects this per-session
# instead when the frontend dial is used; unset/unknown falls back to
# "normal" either way (D5, api/services/orchestrations/voice_conversation/
# _pressure.py).
SESSION_PRESSURE=normal

# Optional — regional Spanish variant for a hand-started bot with no Flask
# session (neutral/castilian/rioplatense/mexican). Flask's /start injects this
# per-session when the frontend selector is used; unset/unknown = "neutral"
# (D2, api/data/spanish_variants.py). Per-variant voice overrides below;
# neutral's voice is AZURE_TTS_VOICE above.
SESSION_VARIANT=neutral
# Persona slug for the session (api/data/personas.py). Injected by Flask's
# /start when a persona is picked; leave unset for no persona. After the
# session, that persona's memory is re-summarised (best-effort, teardown only).
# SESSION_PERSONA=marta
# Max characters of a persona's rolling memory summary.
PERSONA_MEMORY_MAX_CHARS=600
# Roleplay scenario slug for the session (D4). Injected by Flask's /start when
# a roleplay is picked; leave unset for a hand-started bot (no scenario).
# SESSION_SCENARIO_SLUG=ordering_coffee
# AZURE_TTS_VOICE_CASTILIAN=es-ES-ArabellaMultilingualNeural
# AZURE_TTS_VOICE_RIOPLATENSE=es-AR-ElenaNeural
# AZURE_TTS_VOICE_MEXICAN=es-MX-DaliaNeural

# Optional — comma-separated origins allowed past app.py's Origin/Referer
# check (api/app.py). Include both "localhost" and "127.0.0.1" forms for
# whichever host:port you actually browse to — a form missing here 403s.
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173,http://localhost:10000,http://127.0.0.1:5000,http://127.0.0.1:5173,http://127.0.0.1:10000

# Required only by the standalone weekly-digest CLI (roadmap item C5,
# api/exposers/progress_digest.py) — path to your local Obsidian vault root.
# Not read by the Flask app itself.
OBSIDIAN_VAULT_PATH=C:\Users\you\path\to\your\Obsidian\vault

# Optional -- max due mistake patterns in the pre-session priming brief (A3). Default 3.
# DUE_BRIEF_LIMIT=3
# A4: max hard scene constraints emitted from due patterns (default 2)
# SCENE_CONSTRAINT_LIMIT=2

# Optional -- min occurrences for a pattern to be boss-fight eligible (C4). Default 3.
# BOSS_MIN_OCCURRENCES=3

# Optional -- how many recent pronunciation attempts GET /progress/pronunciation returns (oldest to newest). Default 30.
# PRONUNCIATION_TREND_LIMIT=30

# Optional -- F4 second-opinion retrieval. When Generation's grounding judge rejects a
# Review explanation, re-retrieve once with the lexical (Postgres full-text) strategy and
# regenerate. Off by default. Set to true to enable.
# SECOND_OPINION_ENABLED=false

# Optional -- F2 judge-driven ingestion queue. A RAE topic becomes actionable once Review has
# recorded this many weak grounding verdicts against it. List them with
# `python -m api.exposers.ingestion_queue`, ingest with `--ingest`. Default 3.
# INGESTION_QUEUE_THRESHOLD=3

# Optional -- E3 transcript replay: record each voice session to a local WAV in AUDIO_DIR. Default off (0).
# AUDIO_RECORD_ENABLED=0

# Optional -- delete recorded session audio (file + row) older than this many days, at app startup. Default 30.
# AUDIO_RETENTION_DAYS=30

# Optional -- where session WAVs are written. Default <repo>/data/audio (gitignored).
# AUDIO_DIR=
